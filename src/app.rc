#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDI_APP ICON "app.ico"
1 RT_MANIFEST "app.manifest"
IDR_XHSJS RCDATA "xhs.js"

IDD_SETTINGS DIALOGEX 0, 0, 300, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "下载", -1, 7, 7, 286, 94
    LTEXT           "同时下载任务数：", -1, 15, 23, 90, 9
    COMBOBOX        IDC_CONC, 110, 21, 60, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "每个任务的分片线程：", -1, 15, 42, 90, 9
    COMBOBOX        IDC_FRAG, 110, 40, 60, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "限速：", -1, 15, 61, 90, 9
    EDITTEXT        IDC_RATE, 110, 59, 56, 13, ES_AUTOHSCROLL
    COMBOBOX        IDC_RATEUNIT, 170, 58, 50, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "下载字幕", IDC_SUBS, 15, 81, 58, 10
    PUSHBUTTON      "字幕语言…", IDC_SUBLANGS, 76, 79, 64, 14
    AUTOCHECKBOX    "嵌入封面", IDC_THUMB, 160, 81, 100, 10

    GROUPBOX        "网络", -1, 7, 106, 286, 52
    LTEXT           "代理：", -1, 15, 122, 90, 9
    EDITTEXT        IDC_PROXY, 110, 120, 175, 13, ES_AUTOHSCROLL
    LTEXT           "Cookies 来源：", -1, 15, 141, 90, 9
    COMBOBOX        IDC_COOKIES, 110, 139, 130, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "组件", -1, 7, 163, 286, 62
    LTEXT           "yt-dlp", -1, 15, 177, 45, 9
    LTEXT           "", IDC_YTVER, 64, 177, 222, 9
    LTEXT           "ffmpeg", -1, 15, 189, 45, 9
    LTEXT           "", IDC_FFINFO, 64, 189, 222, 9
    PUSHBUTTON      "更新 yt-dlp", IDC_UPDATE, 15, 203, 70, 15
    LTEXT           "", IDC_COMPINFO, 92, 206, 195, 9

    LTEXT           "界面语言：", -1, 9, 232, 50, 9
    COMBOBOX        IDC_LANG, 60, 230, 80, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "确定", IDOK, 189, 230, 50, 15
    PUSHBUTTON      "取消", IDCANCEL, 243, 230, 50, 15
END

IDD_SUBLANGS DIALOGEX 0, 0, 214, 196
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选择字幕语言"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "请选择需要下载的字幕语言（可多选）：", IDC_SL_HEAD, 10, 9, 196, 10
    AUTOCHECKBOX    "", 1101, 14, 26, 92, 11, WS_TABSTOP
    AUTOCHECKBOX    "", 1102, 110, 26, 92, 11, WS_TABSTOP
    AUTOCHECKBOX    "", 1103, 14, 42, 92, 11, WS_TABSTOP
    AUTOCHECKBOX    "", 1104, 110, 42, 92, 11, WS_TABSTOP
    AUTOCHECKBOX    "", 1105, 14, 58, 92, 11, WS_TABSTOP
    AUTOCHECKBOX    "", 1106, 110, 58, 92, 11, WS_TABSTOP
    AUTOCHECKBOX    "", 1107, 14, 74, 92, 11, WS_TABSTOP
    AUTOCHECKBOX    "", 1108, 110, 74, 92, 11, WS_TABSTOP
    AUTOCHECKBOX    "", 1109, 14, 90, 92, 11, WS_TABSTOP
    AUTOCHECKBOX    "", 1110, 110, 90, 92, 11, WS_TABSTOP
    AUTOCHECKBOX    "", 1111, 14, 106, 92, 11, WS_TABSTOP
    AUTOCHECKBOX    "", 1112, 110, 106, 92, 11, WS_TABSTOP
    AUTOCHECKBOX    "", 1113, 14, 122, 92, 11, WS_TABSTOP
    PUSHBUTTON      "全选", IDC_SL_ALL, 10, 142, 50, 14
    PUSHBUTTON      "清空", IDC_SL_NONE, 66, 142, 50, 14
    DEFPUSHBUTTON   "确定", IDOK, 98, 168, 52, 14
    PUSHBUTTON      "取消", IDCANCEL, 154, 168, 52, 14
END


VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "YtGrab 视频下载器"
            VALUE "FileVersion", "1.1.0"
            VALUE "ProductName", "YtGrab"
            VALUE "ProductVersion", "1.1.0"
            VALUE "OriginalFilename", "YtGrab.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
